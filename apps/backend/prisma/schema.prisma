generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  COMPANY
  USER
  INTERVIEWER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum VerificationType {
  ONGOING
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ
  SUBJECTIVE
  SUBJECTIVE_WITH_ANSWER
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  EXPIRED
}

enum NotificationPlacement {
  BANNER
  CARD
}

enum CandidateWorkflowStatus {
  SHORTLISTED
  CONTACTED
  INTERVIEWING
  OFFERED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CompanyInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CompanyVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  role          Role         @default(USER)
  passwordHash  String?
  googleId      String?      @unique
  avatarUrl     String?
  authProvider  AuthProvider @default(EMAIL)
  profile       UserProfile?
  certificate   Certificate?
  rankReleases  RankRelease[]
  rankEntries   RankEntry[]
  termsAcceptances TermsAcceptance[]
  companyProfile        CompanyProfile?  @relation("CompanyProfileUser")
  companyProfileReviews CompanyProfile[] @relation("CompanyProfileReviewer")
  interviewerProfile InterviewerProfile?
  questionPapers QuestionPaper[]
  testAttempts    TestAttempt[] @relation("UserAttempts")
  markedAttempts  TestAttempt[] @relation("MarkedAttempts")
  transactions    Transaction[]
  companyCandidateDecisionsAsCompany CompanyCandidateDecision[] @relation("CompanyDecisionCompany")
  interviewsAsInterviewer Interview[] @relation("InterviewerInterviews")
  interviewsAsStudent     Interview[] @relation("StudentInterviews")
  interviewSlots          InterviewSlot[]
  passwordSetupTokens     PasswordSetupToken[]
  companyInterviewsAsCompany CompanyInterview[] @relation("CompanyInterviewCompany")
  companyInterviewsAsStudent CompanyInterview[] @relation("CompanyInterviewStudent")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  hasActiveSubscription  Boolean      @default(false)
  razorpaySubscriptionId String?      @unique
  razorpayCustomerId     String?

  @@index([role])
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int      // In paise
  currency        String   @default("INR")
  status          String   // "captured", "failed", etc.
  razorpayPaymentId String? @unique
  razorpayOrderId   String?
  razorpaySubscriptionId String?
  description     String?
  receiptUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  // Razorpay event identifier (x-razorpay-event-id header) used to dedupe retries
  eventId     String   @unique
  event       String
  processedAt DateTime @default(now())
}

model UserProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  college           String
  degree            String
  currentYear       String
  specialization    String
  gender            Gender?
  countryCode       String?
  mobileNumber      String?
  linkedinUrl       String?
  resumeUrl         String?
  profilePhotoUrl   String?
  verificationType  VerificationType?
  verificationDocUrl String?
  isComplete        Boolean          @default(false)
  internshipGoal    String?
  internshipDuration String?
  internshipPeriod  String?
  rollNumber        String?          @unique
  cvScore           Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model RollNumberCounter {
  year         Int @id
  lastSequence Int @default(0)
}

model CompanyProfile {
  id                  String                    @id @default(cuid())
  userId              String                    @unique
  user                User                      @relation("CompanyProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  companyLegalName    String
  companyPan          String?
  companyGstin        String?
  operatorName        String
  operatorDesignation String
  operatorIdCardUrl   String?
  verificationStatus  CompanyVerificationStatus @default(PENDING)
  rejectionReason     String?
  reviewedById        String?
  reviewedBy          User?                     @relation("CompanyProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([verificationStatus])
}

model InterviewerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations Specialization[]
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterviewSlot {
  id              String   @id @default(cuid())
  interviewerId   String
  interviewer     User     @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime
  isBooked        Boolean  @default(false)
  interview       Interview?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([interviewerId, startTime])
}

model Interview {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation("StudentInterviews", fields: [studentId], references: [id], onDelete: Cascade)
  interviewerId   String
  interviewer     User     @relation("InterviewerInterviews", fields: [interviewerId], references: [id], onDelete: Cascade)
  slotId          String   @unique
  slot            InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  meetLink        String?
  googleEventId   String?
  marks           Int?
  notes           String?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([interviewerId])
}

model Specialization {
  id             String          @id @default(cuid())
  name           String          @unique
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  questionPapers QuestionPaper[]
  interviewers   InterviewerProfile[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LawCollege {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DegreeOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String                @id @default(cuid())
  placement   NotificationPlacement
  label       String?
  title       String
  description String?
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([placement, isActive, sortOrder])
  @@unique([placement, title])
}

model QuestionPaper {
  id               String                 @id @default(cuid())
  specializationId String
  specialization   Specialization         @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title            String
  description      String?
  versions         QuestionPaperVersion[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model QuestionPaperVersion {
  id               String         @id @default(cuid())
  paperId          String
  paper            QuestionPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  versionName      String
  status           PaperStatus    @default(DRAFT)
  timeLimitMinutes Int            @default(60)
  instructions     String?        // Rich text instructions shown before the test starts
  sections         PaperSection[]
  questions        Question[]
  testAttempts     TestAttempt[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([paperId, versionName])
}

model PaperSection {
  id          String               @id @default(cuid())
  versionId   String
  version     QuestionPaperVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int                  @default(0)
  rules       Json?                // Section-level rules: { allowTabSwitching, allowExternalResources, maxViolations, wordLimit, timeLimitSeconds, questionsToAttempt }
  questions   Question[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Question {
  id                String               @id @default(cuid())
  versionId         String
  version           QuestionPaperVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sectionId         String?
  section           PaperSection?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type              QuestionType
  text              String
  marks             Int                  @default(1)
  options           Json?
  answer            String?
  order             Int                  @default(0)
  timeLimitSeconds  Int?
  parentId          String?
  parent            Question?            @relation("SubQuestions", fields: [parentId], references: [id], onDelete: Cascade)
  subQuestions      Question[]           @relation("SubQuestions")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model TestAttempt {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation("UserAttempts", fields: [userId], references: [id], onDelete: Cascade)
  versionId        String
  version          QuestionPaperVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  startTime        DateTime             @default(now())
  endTime          DateTime?
  status           AttemptStatus        @default(STARTED)
  answers          Json?                // Stores { questionId: answer }
  score            Int?
  questionScores   Json?                // Stores { questionId: marks }
  markedById       String?
  markedBy         User?                @relation("MarkedAttempts", fields: [markedById], references: [id], onDelete: SetNull)
  companyCandidateDecisions CompanyCandidateDecision[] @relation("CompanyDecisionAttempt")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, versionId])
}

model CompanyCandidateDecision {
  id          String                 @id @default(cuid())
  companyId   String
  company     User                   @relation("CompanyDecisionCompany", fields: [companyId], references: [id], onDelete: Cascade)
  attemptId   String
  attempt     TestAttempt            @relation("CompanyDecisionAttempt", fields: [attemptId], references: [id], onDelete: Cascade)
  status      CandidateWorkflowStatus
  notes       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([companyId, attemptId])
  @@index([companyId, status])
  @@index([attemptId])
}

model CompanyInterview {
  id          String                 @id @default(cuid())
  companyId   String
  company     User                   @relation("CompanyInterviewCompany", fields: [companyId], references: [id], onDelete: Cascade)
  studentId   String
  student     User                   @relation("CompanyInterviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  notes       String?
  status      CompanyInterviewStatus @default(SCHEDULED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([companyId, studentId])
  @@index([studentId])
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationCode String   @unique
  rollNumber       String?
  fullName         String
  practiceArea     String
  commonScore      Float
  pdfObjectKey     String
  issuedAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([verificationCode])
}

// A frozen, admin-released snapshot of the common-rank leaderboard. Everything public
// (leaderboard, /ranking/me, certificate QR page) reads the newest release, so ranks only
// change when an admin releases a new one.
model RankRelease {
  id             String      @id @default(cuid())
  label          String
  releasedAt     DateTime    @default(now())
  releasedById   String
  releasedBy     User        @relation(fields: [releasedById], references: [id])
  candidateCount Int
  entries        RankEntry[]

  @@index([releasedAt])
}

model RankEntry {
  id             String      @id @default(cuid())
  releaseId      String
  release        RankRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank           Int
  anonymizedId   String
  practiceArea   String
  testScore      Float
  testMaxScore   Float
  normalizedTest Float
  interviewMarks Float
  cvScore        Float
  commonScore    Float

  @@unique([releaseId, userId])
  @@index([releaseId, rank])
  @@index([userId])
}

// Append-only log of a user accepting the Terms of Use, so we can show which version they
// agreed to and when (currently recorded when a payment is started).
model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  context    String
  acceptedAt DateTime @default(now())

  @@index([userId])
}
