PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lex_assess?schema=public"

# Auth cookie (httpOnly JWT). In production with a cross-site frontend set
# COOKIE_SECURE=true and COOKIE_SAMESITE=none (requires HTTPS). For local dev
# over http://localhost leave them at the defaults below.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.lexassess.in
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override; defaults to ${FRONTEND_ORIGIN}/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Google Service Account (for Calendar)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Object storage. STORAGE_PROVIDER=minio (default) uses local docker-compose
# MinIO; set to "gcs" in staging/prod to use Google Cloud Storage instead.
STORAGE_PROVIDER=minio

# MinIO (local object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lexassess-uploads

# Google Cloud Storage (used when STORAGE_PROVIDER=gcs). On Cloud Run, omit
# GOOGLE_APPLICATION_CREDENTIALS and rely on the attached service account
# (workload identity) instead of a downloaded JSON key.
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=lexassess-uploads
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PLAN_ID=your_razorpay_plan_id
RAZORPAY_WEBHOOK_SECRET=lexassess_secret

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@lexassess.com

# Email campaigns (superadmin)
# Shared secret for POST /internal/email/process (Cloud Scheduler). Unset = worker endpoint disabled.
EMAIL_WORKER_SECRET=
# Mails sent per worker run (the scheduler runs it every minute)
EMAIL_BATCH_SIZE=40
# Keep below the mailbox provider's real limits; account emails share the same mailbox
EMAIL_MAX_PER_HOUR=40
EMAIL_MAX_PER_DAY=250
# Optional: where student replies go, and the public API URL used for one-click unsubscribe headers
EMAIL_REPLY_TO=
API_PUBLIC_URL=
