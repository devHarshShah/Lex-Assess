PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lex_assess?schema=public"

# Auth cookie (httpOnly JWT). In production with a cross-site frontend set
# COOKIE_SECURE=true and COOKIE_SAMESITE=none (requires HTTPS). For local dev
# over http://localhost leave them at the defaults below.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.lexassess.in
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override; defaults to ${FRONTEND_ORIGIN}/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Google Service Account (for Calendar)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# MinIO (local object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lexassess-uploads
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PLAN_ID=your_razorpay_plan_id
RAZORPAY_WEBHOOK_SECRET=lexassess_secret

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@lexassess.com
